# ============================================================
# Honor Tour & Travels – Environment Variables
# Copy this file to .env.local and fill in your real values
# ============================================================

# Your WhatsApp number (with country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Your phone number for click-to-call
NEXT_PUBLIC_PHONE_NUMBER=+919999999999

# Business email
NEXT_PUBLIC_EMAIL=info@honortourtravels.com

# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion ID (optional)
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX

# TravDX CRM public leads API key
NEXT_PUBLIC_TRAVDX_API_KEY=your_travdx_api_key
